{
  "name": "pos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"const fs=require('fs');const path=require('path');function copyDir(s,d){fs.mkdirSync(d,{recursive:true});fs.readdirSync(s).forEach(f=>{const sp=path.join(s,f),dp=path.join(d,f);fs.statSync(sp).isDirectory()?copyDir(sp,dp):fs.copyFileSync(sp,dp)})};fs.existsSync('public/api')&&copyDir('public/api','dist/api');fs.existsSync('public/fonts')&&copyDir('public/fonts','dist/fonts');fs.existsSync('public/favicon.svg')&&fs.copyFileSync('public/favicon.svg','dist/favicon.svg');fs.existsSync('public/.htaccess')&&fs.copyFileSync('public/.htaccess','dist/.htaccess');\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:build:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "esbuild": "^0.28.1",
    "jsbarcode": "^3.12.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "vite": "^8.2.0"
  },
  "build": {
    "appId": "com.pos.system",
    "productName": "POS সিস্টেম",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "database/**/*",
      "electron/**/*",
      "package.json"
    ]
  },
  "author": "POS Team",
  "description": "POS সিস্টেম - বিক্রয়, স্টক ও হিসাব ব্যবস্থা",
  "main": "electron/main.js"
}
