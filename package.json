{
  "name": "pos",
  "private": true,
  "version": "1.1.2000",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "node dev-server.js",
    "build": "vite build && node -e \"const fs=require('fs');const path=require('path');function copyDir(s,d){fs.mkdirSync(d,{recursive:true});fs.readdirSync(s).forEach(f=>{const sp=path.join(s,f),dp=path.join(d,f);fs.statSync(sp).isDirectory()?copyDir(sp,dp):fs.copyFileSync(sp,dp)})};fs.existsSync('public/api')&&copyDir('public/api','dist/api');fs.existsSync('public/fonts')&&copyDir('public/fonts','dist/fonts');fs.existsSync('public/favicon.svg')&&fs.copyFileSync('public/favicon.svg','dist/favicon.svg');fs.existsSync('public/.htaccess')&&fs.copyFileSync('public/.htaccess','dist/.htaccess');fs.existsSync('public/icon.ico')&&fs.copyFileSync('public/icon.ico','dist/icon.ico');fs.existsSync('public/icon.svg')&&fs.copyFileSync('public/icon.svg','dist/icon.svg');\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "postinstall": "electron-builder install-app-deps",
    "electron:build:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "esbuild": "^0.28.1",
    "jsbarcode": "^3.12.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "sharp": "^0.35.3",
    "vite": "^8.2.0"
  },
  "build": {
    "appId": "com.pos.system",
    "productName": "POS System",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "database/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "license": "LICENSE.txt"
    }
  },
  "author": "POS Team",
  "description": "POS System - Sales, Stock & Accounting Management",
  "main": "electron/main.cjs"
}
