{
  "name": "pos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm install && vite build && node -e \"const fs=require('fs');let html=fs.readFileSync('dist/index.html','utf8');const preloader='<style>#preloader{position:fixed;inset:0;background:#0F766E;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24px;z-index:9999}#preloader.hidden{display:none}.preloader-icon{font-size:80px;animation:pulse 2s ease-in-out infinite}.preloader-title{color:white;font-size:32px;font-weight:700}.preloader-text{color:rgba(255,255,255,0.8);font-size:16px}@keyframes pulse{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.1);opacity:0.8}}#root:empty{display:none}</style><div id=preloader><div class=preloader-icon>🏪</div><div class=preloader-title>POS সিস্টেম</div><div class=preloader-text>লোড হচ্ছে...</div></div>';html=html.replace('<div id=root></div>',preloader+'<div id=root></div>');const cssLink=html.match(/<link rel=\"stylesheet\"[^>]*>/);const jsScript=html.match(/<script[^>]*type=\"module\"[^>]*>[\\s\\S]*?<\\/script>/);if(cssLink&&jsScript){html=html.replace(cssLink[0],'').replace(jsScript[0],cssLink[0]+'\\n    '+jsScript[0])}fs.writeFileSync('dist/index.html',html);\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:build:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "esbuild": "^0.28.1",
    "jsbarcode": "^3.12.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "vite": "^8.2.0"
  },
  "build": {
    "appId": "com.pos.system",
    "productName": "POS সিস্টেম",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "api/**/*",
      "public/**/*",
      "router.php",
      "package.json"
    ]
  },
  "author": "POS Team",
  "description": "POS সিস্টেম - বিক্রয়, স্টক ও হিসাব ব্যবস্থা",
  "main": "electron/main.js"
}
